@model MoneyTracker.Models.User

@{
    ViewData["Title"] = "Register - Money Tracker";
}

<div class="container mt-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-lg-10">
            <div class="row shadow-lg rounded overflow-hidden">

                <!-- Left Side Branding -->
                <div class="col-md-6 bg-success text-white p-5 d-flex flex-column justify-content-center">
                    <h1 class="display-4 fw-bold">Join Money Tracker</h1>
                    <h2 class="mb-4">Start tracking smarter today</h2>
                    <p class="lead">
                        Create your account and gain full control over your finances with powerful tracking tools.
                    </p>

                    <div class="mt-4">
                        <div class="card bg-primary text-white mb-3">
                            <div class="card-body">
                                <h6>Personalized Dashboard</h6>
                                <h3>Full Overview</h3>
                            </div>
                        </div>

                        <div class="card bg-danger text-white mb-3">
                            <div class="card-body">
                                <h6>Expense Management</h6>
                                <h3>Track Easily</h3>
                            </div>
                        </div>

                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <h6>Financial Reports</h6>
                                <h3>Visual Insights</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Side Register Form -->
                <div class="col-md-6 bg-white p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">Create Account</h2>
                        <p class="text-muted">Register to begin your financial journey</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            Please correct the highlighted errors.
                        </div>
                    }

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="username" class="form-label fw-semibold">Username</label>
                            <input asp-for="username" class="form-control form-control-lg" placeholder="Choose a username" />
                            <span asp-validation-for="username" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="passwordHash" class="form-label fw-semibold">Password</label>
                            <input asp-for="passwordHash" type="password" class="form-control form-control-lg" placeholder="Create a password" />
                            <span asp-validation-for="passwordHash" class="text-danger"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-person-plus-fill"></i> Register
                            </button>
                        </div>

                        <div class="text-center">
                            <small class="text-muted">
                                Already have an account?
                                <a asp-action="Login" class="text-decoration-none">Login here</a>
                            </small>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
    }

    .form-control:focus {
        box-shadow: none;
        border-color: #198754;
    }

    .card {
        border: none;
        border-radius: 12px;
    }

    .btn-success {
        transition: 0.3s ease-in-out;
    }

        .btn-success:hover {
            transform: translateY(-2px);
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}